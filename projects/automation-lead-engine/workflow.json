{
  "name": "Lead Capture → Qualify → CRM (reliable)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "b1f9a2c0-0001-4a11-9a01-000000000001",
      "name": "Webhook: New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-560, 300],
      "webhookId": "lead-intake"
    },
    {
      "parameters": {
        "jsCode": "// Normalize the incoming payload and build a stable dedupe key.\n// Reject obviously malformed leads early instead of letting them flow downstream.\nconst body = $input.first().json.body || $input.first().json;\nconst email = (body.email || '').trim().toLowerCase();\nconst phone = (body.phone || '').replace(/[^0-9]/g, '');\nif (!email && !phone) {\n  throw new Error('Lead has neither email nor phone — cannot dedupe or contact.');\n}\nconst dedupe_key = email || phone;\nreturn [{ json: {\n  dedupe_key,\n  email,\n  phone,\n  name: (body.name || '').trim(),\n  company: (body.company || '').trim(),\n  message: (body.message || '').trim(),\n  source: body.source || 'web',\n  received_at: new Date().toISOString()\n} }];"
      },
      "id": "b1f9a2c0-0002-4a11-9a01-000000000002",
      "name": "Normalize + Dedupe Key",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-340, 300]
    },
    {
      "parameters": {
        "operation": "get",
        "propertyName": "seen:={{$json.dedupe_key}}"
      },
      "id": "b1f9a2c0-0003-4a11-9a01-000000000003",
      "name": "Seen Before? (Redis)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [-120, 300],
      "continueOnFail": true,
      "notes": "Idempotency check. Swap Redis for a CRM lookup if you prefer. continueOnFail so a Redis blip never blocks a real lead."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose" },
          "combinator": "and",
          "conditions": [
            {
              "leftValue": "={{$json.seen}}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "empty" }
            }
          ]
        }
      },
      "id": "b1f9a2c0-0004-4a11-9a01-000000000004",
      "name": "IF New Lead",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [100, 300]
    },
    {
      "parameters": {
        "modelId": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You qualify inbound B2B leads. Return STRICT JSON only, no prose: {\"tier\":\"hot|warm|cold\",\"intent\":\"string\",\"reason\":\"string\"}. Base tier on buying intent and fit, not politeness."
            },
            {
              "role": "user",
              "content": "=Name: {{$json.name}}\nCompany: {{$json.company}}\nMessage: {{$json.message}}\nSource: {{$json.source}}"
            }
          ]
        },
        "jsonOutput": true,
        "options": { "temperature": 0 }
      },
      "id": "b1f9a2c0-0005-4a11-9a01-000000000005",
      "name": "AI Qualify (schema-checked)",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [320, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "notes": "Temperature 0 + JSON output. Retry x3 with backoff so a transient model/API error does not lose the lead."
    },
    {
      "parameters": {
        "jsCode": "// Validate the model output BEFORE it touches the CRM.\n// If the model returned a shape we do not trust, fall back to 'warm' + human review\n// instead of writing garbage or dropping the lead.\nconst allowed = ['hot', 'warm', 'cold'];\nlet out = $input.first().json;\nlet ai = out.message?.content ?? out.output ?? out;\nif (typeof ai === 'string') { try { ai = JSON.parse(ai); } catch (e) { ai = {}; } }\nlet tier = (ai.tier || '').toLowerCase();\nlet needs_review = false;\nif (!allowed.includes(tier)) { tier = 'warm'; needs_review = true; }\nreturn [{ json: {\n  ...$('Normalize + Dedupe Key').first().json,\n  tier,\n  intent: ai.intent || 'unknown',\n  reason: ai.reason || 'model output failed validation',\n  needs_review\n} }];"
      },
      "id": "b1f9a2c0-0006-4a11-9a01-000000000006",
      "name": "Validate AI Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [540, 220]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": false, "typeValidation": "loose" }, "combinator": "and", "conditions": [ { "leftValue": "={{$json.tier}}", "rightValue": "hot", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "hot" },
            { "conditions": { "options": { "caseSensitive": false, "typeValidation": "loose" }, "combinator": "and", "conditions": [ { "leftValue": "={{$json.tier}}", "rightValue": "warm", "operator": { "type": "string", "operation": "equals" } } ] }, "outputKey": "warm" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "b1f9a2c0-0007-4a11-9a01-000000000007",
      "name": "Route by Tier",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [760, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.your-crm.example/v1/contacts",
        "sendHeaders": true,
        "headerParameters": { "parameters": [ { "name": "Authorization", "value": "=Bearer {{$env.CRM_API_KEY}}" }, { "name": "Idempotency-Key", "value": "={{$json.dedupe_key}}" } ] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email: $json.email, phone: $json.phone, name: $json.name, company: $json.company, lifecycle_stage: $json.tier === 'hot' ? 'sales_ready' : 'lead', notes: $json.reason, owner_queue: $json.tier }) }}",
        "options": {}
      },
      "id": "b1f9a2c0-0008-4a11-9a01-000000000008",
      "name": "Upsert CRM (idempotent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [980, 220],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "notes": "Idempotency-Key = dedupe key so a retry never creates a duplicate contact."
    },
    {
      "parameters": {
        "operation": "set",
        "key": "=seen:{{$json.dedupe_key}}",
        "value": "1",
        "expire": true,
        "ttl": 2592000
      },
      "id": "b1f9a2c0-0009-4a11-9a01-000000000009",
      "name": "Mark Seen (30d TTL)",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1200, 220]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "sales-hot-leads", "mode": "name" },
        "text": "=:fire: *HOT lead* — {{$json.name}} ({{$json.company}})\nIntent: {{$json.intent}}\nWhy: {{$json.reason}}\n{{$json.email}} · {{$json.phone}}",
        "otherOptions": {}
      },
      "id": "b1f9a2c0-0010-4a11-9a01-000000000010",
      "name": "Slack: Alert Sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1420, 120],
      "continueOnFail": true,
      "notes": "continueOnFail: a Slack outage should never fail the run after the CRM write already succeeded."
    },
    {
      "parameters": {
        "content": "## Duplicate — skipped\nLead already seen within the TTL window. No CRM write, no alert. Prevents double outreach.",
        "height": 140,
        "width": 260
      },
      "id": "b1f9a2c0-0011-4a11-9a01-000000000011",
      "name": "Note: Duplicate path",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [320, 460]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, dedupe_key: $json.dedupe_key, tier: $json.tier || 'duplicate' }) }}",
        "options": {}
      },
      "id": "b1f9a2c0-0012-4a11-9a01-000000000012",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1640, 220]
    }
  ],
  "connections": {
    "Webhook: New Lead": { "main": [ [ { "node": "Normalize + Dedupe Key", "type": "main", "index": 0 } ] ] },
    "Normalize + Dedupe Key": { "main": [ [ { "node": "Seen Before? (Redis)", "type": "main", "index": 0 } ] ] },
    "Seen Before? (Redis)": { "main": [ [ { "node": "IF New Lead", "type": "main", "index": 0 } ] ] },
    "IF New Lead": { "main": [ [ { "node": "AI Qualify (schema-checked)", "type": "main", "index": 0 } ], [ { "node": "Respond 200", "type": "main", "index": 0 } ] ] },
    "AI Qualify (schema-checked)": { "main": [ [ { "node": "Validate AI Output", "type": "main", "index": 0 } ] ] },
    "Validate AI Output": { "main": [ [ { "node": "Route by Tier", "type": "main", "index": 0 } ] ] },
    "Route by Tier": { "main": [ [ { "node": "Upsert CRM (idempotent)", "type": "main", "index": 0 } ], [ { "node": "Upsert CRM (idempotent)", "type": "main", "index": 0 } ], [ { "node": "Upsert CRM (idempotent)", "type": "main", "index": 0 } ] ] },
    "Upsert CRM (idempotent)": { "main": [ [ { "node": "Mark Seen (30d TTL)", "type": "main", "index": 0 } ] ] },
    "Mark Seen (30d TTL)": { "main": [ [ { "node": "Slack: Alert Sales", "type": "main", "index": 0 } ] ] },
    "Slack: Alert Sales": { "main": [ [ { "node": "Respond 200", "type": "main", "index": 0 } ] ] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "staticData": null,
  "meta": { "note": "Representative reference workflow by Samia M. Replace CRM URL, credentials and channel with your own. Runs the same shape on n8n Cloud or self-hosted." },
  "pinData": {},
  "versionId": "reference-1.0.0",
  "tags": [ { "name": "lead-gen" }, { "name": "reliable-automation" } ]
}
